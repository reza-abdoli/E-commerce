@if (TempData["SuccessMessage"] != null)
{
    <script>
        $(document).ready(function () {
            Swal.fire({
                title: "پیغام موفقیت",
                text: '@Html.Raw(TempData["SuccessMessage"])',
                icon: "success",
                width: '28em',
                confirmButtonText: "باشه"
            });
        });
    </script>
}

