@model Data.DTOs.Paging.BasePaging

@if (Model.PageCount > 1)
{
    <nav class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-4">

        @* وضعیت نمایش *@
        <span class="text-muted font-13">
            @Model.GetCurrentPagingStatus()
        </span>

        @* دکمه‌های صفحه‌بندی *@
        <ul class="pagination pagination-sm mb-0">

            @* صفحه اول *@
            @if (Model.PageId > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@GetPageUrl(1)">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="@GetPageUrl(Model.PageId - 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }

            @* صفحات میانی *@
            @for (int i = Model.StartPage; i <= Model.EndPage; i++)
            {
                <li class="page-item @(i == Model.PageId ? "active" : "")">
                    <a class="page-link @(i == Model.PageId ? "bg-danger border-danger" : "")"
                       href="@GetPageUrl(i)">
                        @i
                    </a>
                </li>
            }

            @* صفحه آخر *@
            @if (Model.PageId < Model.PageCount)
            {
                <li class="page-item">
                    <a class="page-link" href="@GetPageUrl(Model.PageId + 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="@GetPageUrl(Model.PageCount)">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
            }

        </ul>
    </nav>
}

@functions {
    string GetPageUrl(int page)
    {
        var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            Context.Request.QueryString.Value ?? "");

        qs["PageId"] = page.ToString();

        var newQs = string.Join("&", qs.Select(k => $"{k.Key}={k.Value}"));
        return $"{Context.Request.Path}?{newQs}";
    }
}
