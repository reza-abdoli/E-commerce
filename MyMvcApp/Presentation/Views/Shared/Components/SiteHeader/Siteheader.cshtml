@using Data.Entities
@{
    var categories = ViewData["Categories"] as List<ProductCategory> ?? new();
    var parents = categories.Where(c => c.ParentId == null).OrderBy(c => c.Order).ToList();
}

<header class="header">
    <div class="container-fluid">
        <div class="top-header py-3">
            <div class="row align-items-center gy-3">

                @* لوگو *@
                <div class="col-lg-2 col-6">
                    <a href="/" class="d-flex align-items-center text-decoration-none gap-2">
                        <span style="font-size:22px;font-weight:700;color:#e53935">E</span>
                        <span style="font-size:18px;font-weight:600;color:#1a1a1a">SHOP</span>
                    </a>
                </div>

                @* جستجو *@
                <div class="col-lg-6 d-none d-lg-block">
                    <form asp-controller="Product" asp-action="FilterProducts" method="get">
                        <div class="input-group">
                            <input type="text" name="Title" class="form-control" placeholder="جستجوی محصول...">
                            <button class="btn btn-danger" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                @* آیکون‌های هدر *@
                <div class="col-lg-4 col-6">
                    <div class="d-flex align-items-center justify-content-end gap-3">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Logout"
                               class="d-flex align-items-center gap-1 text-decoration-none text-dark">
                                <i class="bi bi-door-open fs-5"></i>
                                <span class="d-none d-sm-inline font-14">خروج از حساب کاربری</span>
                            </a>
                        }
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Login"
                               class="d-flex align-items-center gap-1 text-decoration-none text-dark">
                                <i class="bi bi-person fs-5"></i>
                                <span class="d-none d-sm-inline font-14">حساب کاربری</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="d-flex align-items-center gap-1 text-decoration-none text-dark">
                                <i class="bi bi-person fs-5"></i>
                                <span class="d-none d-sm-inline font-14">ورود / عضویت</span>
                            </a>
                        }

                        <a asp-area="User" asp-controller="Order" asp-action="Cart"
                           class="d-flex align-items-center gap-1 text-decoration-none text-dark">
                            <i class="bi bi-cart fs-5"></i>
                            <span class="d-none d-sm-inline font-14">سبد خرید</span>
                        </a>

                        @* همبرگر موبایل *@
                        <button class="btn d-lg-none border-0 p-0" data-bs-toggle="offcanvas"
                                data-bs-target="#mobileMenu">
                            <i class="bi bi-list fs-3"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

@* ─── منوی اصلی Desktop ─── *@
<nav class="main-nav d-none d-lg-block border-bottom bg-white">
    <div class="container-fluid">
        <ul class="nav align-items-center py-2 gap-1">

            <li class="nav-item dropdown">
                <a class="nav-link fw-bold d-flex align-items-center gap-1" href="#" role="button"
                   data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-grid"></i> دسته‌بندی‌ها
                    <i class="bi bi-chevron-down font-12"></i>
                </a>
                <ul class="dropdown-menu mega-menu p-3" style="min-width:600px">
                    <div class="row g-3">
                        @foreach (var parent in parents)
                        {
                            var children = categories
                                .Where(c => c.ParentId == parent.Id)
                                .OrderBy(c => c.Order)
                                .ToList();
                            <div class="col-4">
                                <a asp-controller="Product" asp-action="FilterProducts" asp-route-url="@parent.Url"
                                   class="fw-bold font-14 mb-2 text-danger">
                                    @parent.Title
                                </a>
                                <ul class="list-unstyled">
                                    @foreach (var child in children)
                                    {
                                        <li>
                                            <a asp-controller="Product" asp-action="FilterProducts" asp-route-url="@child.Url"
                                               class="dropdown-item font-13 py-1 px-0 text-muted">
                                                @child.Title
                                            </a>
                                        </li>
                                        @* سطح سوم *@
                                        @foreach (var sub in categories.Where(c => c.ParentId == child.Id))
                                        {
                                            <li>
                                                <a asp-controller="Product" asp-action="FilterProducts" asp-route-url="@sub.Url"
                                                   class="dropdown-item font-13 py-1 px-2 text-muted">
                                                    <i class="bi bi-dash font-12"></i> @sub.Title
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </ul>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/">خانه</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Product" asp-action="FilterProducts">
                    همه محصولات
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">تخفیف‌ها</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">تماس با ما</a>
            </li>

        </ul>
    </div>
</nav>

@* ─── منوی موبایل (Offcanvas) ─── *@
<div class="offcanvas offcanvas-start" id="mobileMenu" tabindex="-1">
    <div class="offcanvas-header border-bottom">
        <h6 class="offcanvas-title fw-bold">MyShop</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">

        @* جستجو موبایل *@
        <form asp-controller="Product" asp-action="FilterProducts" method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="Title" class="form-control font-14" placeholder="جستجوی محصول...">
                <button class="btn btn-danger" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>

        @* منوی دسته‌بندی موبایل - آکاردئون *@
        <div class="accordion accordion-flush" id="mobileMenuAccordion">
            @{
                int idx = 0;
            }
            @foreach (var parent in parents)
            {
                var children = categories
                    .Where(c => c.ParentId == parent.Id)
                    .OrderBy(c => c.Order)
                    .ToList();
                <div class="accordion-item border-0 border-bottom">
                    @if (children.Any())
                    {
                        <h6 class="accordion-header">
                            <button class="accordion-button collapsed py-2 font-14 fw-500" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#mob-cat-@idx">
                                @parent.Title
                            </button>
                        </h6>
                        <div id="mob-cat-@idx" class="accordion-collapse collapse" data-bs-parent="#mobileMenuAccordion">
                            <div class="accordion-body py-1 ps-4">
                                @foreach (var child in children)
                                {
                                    <a asp-controller="Product" asp-action="FilterProducts" asp-route-url="@child.Url"
                                       class="d-block py-1 font-13 text-muted text-decoration-none">
                                        @child.Title
                                    </a>
                                    @foreach (var sub in categories.Where(c => c.ParentId == child.Id))
                                    {
                                        <a asp-controller="Product" asp-action="FilterProducts" asp-route-url="@sub.Url"
                                           class="d-block py-1 font-13 text-muted text-decoration-none ps-3">
                                            <i class="bi bi-dash font-12"></i> @sub.Title
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Product" asp-action="FilterProducts" asp-route-url="@parent.Url"
                           class="d-block py-2 font-14 text-decoration-none text-dark px-3">
                            @parent.Title
                        </a>
                    }
                </div>
                idx++;
            }
        </div>

        <div class="mt-3 border-top pt-3">
            <a href="/" class="d-block py-2 font-14 text-decoration-none text-dark">
                <i class="bi bi-house me-2"></i>خانه
            </a>
            <a asp-controller="Product" asp-action="FilterProducts"
               class="d-block py-2 font-14 text-decoration-none text-dark">
                <i class="bi bi-grid me-2"></i>همه محصولات
            </a>
            @if (User.Identity!.IsAuthenticated)
            {
                <a asp-area="" asp-controller="Account" asp-action="Login"
                   class="d-block py-2 font-14 text-decoration-none text-dark">
                    <i class="bi bi-person me-2"></i>حساب کاربری
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="d-block py-2 font-14 text-decoration-none text-dark">
                    <i class="bi bi-person me-2"></i>ورود / عضویت
                </a>
            }
        </div>
    </div>
</div>