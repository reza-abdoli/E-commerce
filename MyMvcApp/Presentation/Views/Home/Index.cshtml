@using Application.Extensions
@using Data.DTOs.Common
@using Data.DTOs.Product
@using Data.Entities
@using Data.Entities.Common
@{
    ViewData["Title"] = "فروشگاه MyShop";
    var banners    = ViewData["Banners"]    as List<BannerItemDto>    ?? new();
    var categories = ViewData["Categories"] as List<ProductCategory>  ?? new();
    var products   = ViewData["Products"]   as List<ProductItemDto>   ?? new();
}

<style>
    /* ─── استایل‌های اختصاصی برای مدرن‌سازی ظاهر سایت ─── */
    .modern-card {
        transition: all 0.3s ease;
        border: 1px solid #f1f2f4 !important;
    }
    .modern-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }
    .cat-circle {
        transition: all 0.3s ease;
    }
    .cat-card:hover .cat-circle {
        transform: scale(1.08);
        border-color: #dc3545 !important;
    }
    
    /* تنظیمات اختصاصی اسلایدر اصلی برای حل مشکل تصاویر نامناسب */
    .slider-container {
        height: 400px;
        position: relative;
    }
    .slider-bg-blur {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-size: cover;
        background-position: center;
        filter: blur(20px) brightness(0.75);
        transform: scale(1.1);
        z-index: 1;
    }
    .slider-main-img {
        position: relative;
        z-index: 2;
        height: 100%;
        width: 100%;
        object-fit: contain;
    }

    /* شخصی‌سازی دکمه‌های ناوبری اسلایدرها */
    .swiper-button-next, .swiper-button-prev {
        background: rgba(255, 255, 255, 0.9);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .swiper-button-next::after, .swiper-button-prev::after {
        font-size: 16px;
        color: #333;
        font-weight: bold;
    }
    .text-overflow-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 44px;
    }

    /* بهینه‌سازی برای نمایشگرهای موبایل */
    @@media (max-width: 768px) {
        .slider-container {
            height: 220px;
        }
    }
</style>

@* ─── اسلایدر اصلی مدرن ─── *@
@if (banners.Any(b => b.BannerLocation == BannerLocation.Slider))
{
    <section class="py-4">
        <div class="container">
            <div class="swiper home-slider rounded-4 overflow-hidden shadow-sm border">
                <div class="swiper-wrapper">
                    @foreach (var b in banners
                        .Where(b => b.BannerLocation == BannerLocation.Slider)
                        .OrderBy(b => b.Order))
                    {
                        var imgPath = PathExtension.BannerThumb + b.ImageName;
                        <div class="swiper-slide">
                            <a asp-area="" asp-controller="Product" asp-action="FilterProducts" asp-route-url="@b.Url" class="d-block slider-container overflow-hidden">
                                <div class="slider-bg-blur" style="background-image: url('@imgPath');"></div>
                                <img src="@imgPath" class="slider-main-img" alt="@b.Title">
                            </a>
                        </div>
                    }
                </div>
                <div class="swiper-pagination"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    </section>
}

@* ─── ویژگی‌های فروشگاه ─── *@
<section class="py-3 my-2">
    <div class="container">
        <div class="bg-white rounded-4 p-4 border shadow-sm">
            <div class="row g-4 text-center justify-content-center">
                @{
                    var features = new[]
                    {
                        ("bi-shield-check",   "کالای اصل",      "با گارانتی معتبر"),
                        ("bi-arrow-repeat",   "بازگشت کالا",    "تا ۷ روز به هر دلیل"),
                        ("bi-truck",          "ارسال سریع",     "به سراسر ایران"),
                        ("bi-headset",        "پشتیبانی ۲۴ ساعته", "۷ روز هفته"),
                        ("bi-credit-card",    "پرداخت امن",     "درگاه معتبر بانکی"),
                    };
                }
                @foreach (var (icon, title, sub) in features)
                {
                    <div class="col-6 col-md-4 col-lg">
                        <div class="d-flex align-items-center gap-3 justify-content-start justify-content-lg-center">
                            <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi @icon fs-4"></i>
                            </div>
                            <div class="text-start">
                                <h6 class="fw-bold mb-1 font-14 text-dark">@title</h6>
                                <p class="text-muted mb-0 font-12">@sub</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ─── دسته‌بندی‌ها ─── *@
@if (categories.Any(c => c.ParentId == null))
{
    <section class="py-4">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h5 class="fw-bold mb-0 text-dark">
                    دسته‌بندی <span class="text-danger border-bottom border-2 border-danger pb-1">محصولات</span>
                </h5>
                <a asp-controller="Product" asp-action="FilterProducts"
                   class="btn btn-sm btn-link text-danger text-decoration-none fw-bold">مشاهده همه <i class="bi bi-chevron-left font-12"></i></a>
            </div>
            <div class="row g-3 justify-content-center">
                @foreach (var cat in categories
                    .Where(c => c.ParentId == null)
                    .OrderBy(c => c.Order)
                    .Take(8))
                {
                    <div class="col-4 col-sm-3 col-md-2-4 col-lg-1-5 text-center">
                        <a asp-controller="Product"
                           asp-action="FilterProducts"
                           asp-route-url="@cat.Url"
                           class="text-decoration-none cat-card d-block">
                            <div class="border-0 rounded-4 p-3 text-center bg-white d-flex flex-column align-items-center gap-2">
                                <div class="cat-circle border p-1" style="width:75px; height:75px; border-radius:50%; overflow:hidden; background:#fdfdfd">
                                    <img src="@(PathExtension.CategoryThumb + cat.MainImage)"
                                         alt="@cat.Title"
                                         class="rounded-circle"
                                         style="width:100%; height:100%; object-fit:cover">
                                </div>
                                <span class="font-13 fw-bold text-secondary mt-1">@cat.Title</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ─── بنر ردیف اول ─── *@
@if (banners.Any(b => b.BannerLocation == BannerLocation.FirstRow))
{
    <section class="py-3">
        <div class="container">
            <div class="row g-3">
                @foreach (var b in banners
                    .Where(b => b.BannerLocation == BannerLocation.FirstRow)
                    .OrderBy(b => b.Order))
                {
                    <div class="col-md-6">
                        <a href="@b.Url" class="d-block overflow-hidden rounded-4 shadow-sm modern-card">
                            <img src="@(PathExtension.BannerThumb + b.ImageName)"
                                 alt="@b.Title"
                                 class="img-fluid w-100"
                                 style="max-height:220px; object-fit:cover;">
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ─── جدیدترین محصولات ─── *@
@if (products.Any())
{
    <section class="py-4 position-relative">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h5 class="fw-bold mb-0 text-dark">
                    محصولات <span class="text-danger border-bottom border-2 border-danger pb-1">تازه‌وارد</span>
                </h5>
                <a asp-controller="Product" asp-action="FilterProducts"
                   class="btn btn-sm btn-link text-danger text-decoration-none fw-bold">مشاهده همه <i class="bi bi-chevron-left font-12"></i></a>
            </div>
            <div class="swiper products-slider px-1 py-2">
                <div class="swiper-wrapper">
                    @foreach (var p in products)
                    {
                        <div class="swiper-slide">
                            <a asp-controller="Product"
                               asp-action="ProductDetail"
                               asp-route-productId="@p.ProductId"
                               class="text-decoration-none">
                                <div class="bg-white rounded-4 overflow-hidden modern-card h-100 d-flex flex-column shadow-sm">
                                    <div class="p-3 bg-light d-flex align-items-center justify-content-center" style="height:210px; overflow:hidden">
                                        <img src="@(PathExtension.ProductImageThumb + p.Image)"
                                             alt="@p.Title"
                                             class="img-fluid"
                                             style="max-height:100%; object-fit:contain">
                                    </div>
                                    <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                        <p class="font-13 fw-bold text-dark mb-3 text-overflow-2 text-start">@p.Title</p>
                                        <div class="d-flex align-items-center justify-content-between mt-auto">
                                            <span class="text-muted font-11">قیمت:</span>
                                            <p class="fw-bolder text-danger mb-0 font-15">
                                                @p.Price.ToString("N0") <span class="font-11 text-dark fw-normal">تومان</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    </section>
}

@* ─── بنر ردیف دوم ─── *@
@if (banners.Any(b => b.BannerLocation == BannerLocation.SecondRow))
{
    <section class="py-3 mb-5">
        <div class="container">
            <div class="row g-3">
                @foreach (var b in banners
                    .Where(b => b.BannerLocation == BannerLocation.SecondRow)
                    .OrderBy(b => b.Order))
                {
                    <div class="col-md-6">
                        <a href="@b.Url" class="d-block overflow-hidden rounded-4 shadow-sm modern-card">
                            <img src="@(PathExtension.BannerThumb + b.ImageName)"
                                 alt="@b.Title"
                                 class="img-fluid w-100"
                                 style="max-height:220px; object-fit:cover">
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@section SiteFooterSection {
    <script>
        // اسلایدر اصلی با افکت Fade هوشمند
        new Swiper('.home-slider', {
            loop: true,
            effect: 'fade',
            fadeEffect: { crossFade: true },
            autoplay: { delay: 4500, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            navigation: {
                nextEl: '.home-slider .swiper-button-next',
                prevEl: '.home-slider .swiper-button-prev',
            },
        });

        // اسلایدر محصولات واکنشی
        new Swiper('.products-slider', {
            slidesPerView: 2,
            spaceBetween: 16,
            navigation: {
                nextEl: '.products-slider .swiper-button-next',
                prevEl: '.products-slider .swiper-button-prev',
            },
            breakpoints: {
                576:  { slidesPerView: 2.3 },
                768:  { slidesPerView: 3 },
                992:  { slidesPerView: 4 },
                1200: { slidesPerView: 4.5 },
            },
        });
    </script>
}