@using Data.Entities
@model Data.DTOs.Product.CreateProductDto
@{
    var brands     = ViewData["Brands"]     as List<Brand>              ?? new List<Brand>();
    var categories = ViewData["Categories"] as List<ProductCategory>    ?? new List<ProductCategory>();
}

<div class="page-header">
    <div class="page-sub-title">@ViewData["Title"]</div>
    <a asp-action="FilterProduct" class="btn-blue">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> بازگشت به لیست
    </a>
</div>

<form asp-action="CreateProduct" method="post" enctype="multipart/form-data">

    <div class="form-card">
        <div class="form-section-title">
            اطلاعات پایه
            <span class="dto-label">CreateProductDto</span>
        </div>

        <div class="two">
            <div class="fg">
                <label asp-for="Title">عنوان محصول (Title)</label>
                <input asp-for="Title" placeholder="مثال: پیراهن اسلیم‌فیت مردانه">
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="fg">
                <label asp-for="BasePrice">قیمت پایه — تومان (BasePrice)</label>
                <input asp-for="BasePrice" id="price-input" placeholder="مثال: 450,000">
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>
        </div>

        <div class="two">
            <div class="fg">
                <label asp-for="BrandId">برند (BrandId)</label>
                <select asp-for="BrandId">
                    <option value="0">— بدون برند —</option>
                    @foreach (var brand in brands.OrderBy(b => b.Title))
                    {
                        <option value="@brand.Id">@brand.Title</option>
                    }
                </select>
            </div>
            <div class="fg">
                <label>وضعیت موجودی (IsAvailable)</label>
                <div class="toggle-wrap" style="margin-top:8px">
                    <input type="hidden" asp-for="IsAvailable" id="isAvailable-val">
                    @* کلاس "on" رو مستقیم از Model میگیریم *@
                    <div class="toggle @(Model.IsAvailable ? "on" : "")" id="tog-avail"></div>
                    <span id="tog-avail-label">@(Model.IsAvailable ? "موجود" : "ناموجود")</span>
                </div>
            </div>
        </div>

        <div class="fg">
            <label asp-for="ShortDescription">توضیح کوتاه (ShortDescription)</label>
            <textarea asp-for="ShortDescription" rows="2"
                      placeholder="یک جمله توضیح کوتاه..."></textarea>
        </div>
        <div class="fg">
            <label asp-for="Description">توضیحات کامل (Description)</label>
            <textarea asp-for="Description" rows="4"
                      placeholder="توضیحات کامل محصول..."></textarea>
        </div>
    </div>

    <div class="form-card">
        <div class="form-section-title">تصاویر محصول</div>
        <div class="two">
            <div class="fg">
                <label asp-for="MainImage">تصویر اصلی (MainImage)</label>
                <div class="file-zone" onclick="document.getElementById('main-img').click()">
                    <i class="ti ti-photo" aria-hidden="true"></i>
                    انتخاب تصویر اصلی
                    <input asp-for="MainImage"
                           type="file" id="main-img"
                           accept="image/*" style="display:none"
                           onchange="previewImg(this,'main-preview')">
                </div>
                <img id="main-preview" class="img-preview" alt="پیش‌نمایش">
                <span asp-validation-for="MainImage" class="text-danger"></span>
            </div>
            <div class="fg">
                <label asp-for="ProductGalleries">گالری تصاویر — اختیاری (ProductGalleries)</label>
                <div class="file-zone" onclick="document.getElementById('gallery-imgs').click()">
                    <i class="ti ti-layout-grid" aria-hidden="true"></i>
                    انتخاب چند تصویر
                    <input asp-for="ProductGalleries"
                        type="file" id="gallery-imgs"
                        accept="image/*" multiple style="display:none"
                        onchange="showGalleryPreviews(this)">
                </div>
                <div id="gallery-previews"
                    style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px"></div>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-section-title">دسته‌بندی‌های محصول (Categories)</div>
        <p class="hint" style="margin-bottom:10px">می‌توانید چند دسته‌بندی انتخاب کنید</p>
        <div style="border:1px solid var(--border); border-radius:8px; padding:14px;
                    max-height:260px; overflow-y:auto; background:#fafbfc">
            @await Component.InvokeAsync("SelectedCategories", new
            {
                thisId = (long?)null,
                selectedCategories = (List<long>?)null,
                level = 0
            })
        </div>
        <span class="text-danger" id="cat-error"></span>
    </div>

    <div class="form-actions" style="margin-top:0">
        <button type="submit" class="btn-green">
            <i class="ti ti-device-floppy" aria-hidden="true"></i> ذخیره محصول
        </button>
        <a asp-action="FilterProduct" class="btn-outline">انصراف</a>
    </div>

</form>

@section AdminFooterSection {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // toggle IsAvailable
        const tog = document.getElementById('tog-avail');
        const lbl = document.getElementById('tog-avail-label');
        const val = document.getElementById('isAvailable-val');

        // مقدار اولیه رو از hidden input که asp-for ست کرده میخونیم
        // نیازی به هاردکد کردن نیست

        tog.addEventListener('click', () => {
            tog.classList.toggle('on');
            const isOn = tog.classList.contains('on');
            lbl.textContent = isOn ? 'موجود' : 'ناموجود';
            val.value = isOn ? 'true' : 'false';
        });

        function showGalleryPreviews(input) {
            const container = document.getElementById('gallery-previews');
            container.innerHTML = '';

            if (!input.files || input.files.length === 0) return;

            Array.from(input.files).forEach((file, index) => {
                if (!file.type.startsWith('image/')) return;

                const reader = new FileReader();
                reader.onload = e => {
                    const wrapper = document.createElement('div');
                    wrapper.style.cssText = 'position:relative; flex-shrink:0';

                    // عکس کوچک
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.cssText = `
                        width: 72px;
                        height: 72px;
                        object-fit: cover;
                        border-radius: 6px;
                        border: 1px solid var(--border);
                        display: block;
                    `;

                    // شماره روی عکس
                    const badge = document.createElement('span');
                    badge.textContent = index + 1;
                    badge.style.cssText = `
                        position: absolute;
                        top: 4px;
                        right: 4px;
                        background: rgba(0,0,0,0.55);
                        color: #fff;
                        font-size: 10px;
                        font-weight: 600;
                        width: 18px;
                        height: 18px;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-family: var(--font-main);
                    `;

                    wrapper.appendChild(img);
                    wrapper.appendChild(badge);
                    container.appendChild(wrapper);
                };
                reader.readAsDataURL(file);
            });

            // نمایش تعداد کل
            const countEl = document.createElement('div');
            countEl.style.cssText = `
                width: 72px;
                height: 72px;
                border-radius: 6px;
                border: 1px dashed var(--border-mid);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                color: var(--text-muted);
                font-size: 11px;
                flex-shrink: 0;
                gap: 4px;
                background: #fafbfc;
            `;
            countEl.innerHTML = `
                <i class="ti ti-photos" style="font-size:20px"></i>
                ${input.files.length} تصویر
            `;
            container.appendChild(countEl);
        }

        // فرمت قیمت با جداکننده هزار
        const priceInput = document.getElementById('price-input');
        priceInput.addEventListener('input', () => {
            let raw = priceInput.value.replace(/,/g, '');
            if (!isNaN(raw) && raw !== '') {
                priceInput.value = Number(raw).toLocaleString('en');
            }
        });
    </script>
}