@model Data.DTOs.Account.EditUserInfoDTO
@{
    ViewData["Title"] = "اطلاعات کاربری";
    var returnToCheckout = (bool)(ViewData["ReturnToCheckout"] ?? false);
    Layout = "_UserLayout";
}

<div class="container-fluid py-4 px-4">

    @if (returnToCheckout)
    {
        <div class="alert alert-warning font-13 py-2 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-info-circle"></i>
            برای ادامه فرآیند پرداخت، لطفاً اطلاعات زیر را تکمیل کنید.
        </div>
    }

    <div class="row g-4">

        @* ─── فرم اطلاعات ─── *@
        <div class="col-lg-7">
            <div class="bg-white rounded-4 border shadow-sm p-4">

                <h6 class="fw-bold mb-4">
                    <i class="bi bi-person-lines-fill text-danger me-2"></i>اطلاعات شخصی
                </h6>

                <form asp-area="User" asp-controller="Account" asp-action="EditUserDetail"
                      asp-route-returnToCheckout="@returnToCheckout" method="post" novalidate>

                    <input type="hidden" asp-for="UserId">

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="FullName" class="form-label fw-bold font-13"></label>
                            <input asp-for="FullName" class="form-control form-control-sm"
                                   placeholder="مثال: علی رضایی">
                            <span asp-validation-for="FullName" class="text-danger font-12"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="MobileNumber" class="form-label fw-bold font-13"></label>
                            <input asp-for="MobileNumber" class="form-control form-control-sm"
                                   placeholder="09123456789" maxlength="11">
                            <span asp-validation-for="MobileNumber" class="text-danger font-12"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="Email" class="form-label fw-bold font-13">ایمیل</label>
                            <input asp-for="Email" type="email" class="form-control form-control-sm"
                                   placeholder="example@email.com">
                            <span asp-validation-for="Email" class="text-danger font-12"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="UserCity" class="form-label fw-bold font-13">شهر</label>
                            <input asp-for="UserCity" class="form-control form-control-sm"
                                   placeholder="مثال: تهران">
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="PostCode" class="form-label fw-bold font-13"></label>
                            <input asp-for="PostCode" class="form-control form-control-sm"
                                   placeholder="کد پستی ۱۰ رقمی" maxlength="10">
                            <span asp-validation-for="PostCode" class="text-danger font-12"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-bold font-13"></label>
                            <textarea asp-for="Address" class="form-control form-control-sm"
                                      rows="3" placeholder="آدرس کامل پستی"></textarea>
                            <span asp-validation-for="Address" class="text-danger font-12"></span>
                        </div>

                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-danger px-4">
                                @if (returnToCheckout)
                                {
                                    <i class="bi bi-arrow-left me-1"></i>
                                    <span>ذخیره و ادامه به پرداخت</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2 me-1"></i>
                                    <span>ذخیره اطلاعات</span>
                                }
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </div>

        @* ─── کارت راهنما ─── *@
        <div class="col-lg-5">
            <div class="bg-white rounded-4 border shadow-sm p-4">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-info-circle text-danger me-2"></i>راهنما
                </h6>
                <ul class="list-unstyled font-13 text-muted d-flex flex-column gap-2 mb-0">
                    <li class="d-flex gap-2">
                        <i class="bi bi-check2-circle text-success mt-1 flex-shrink-0"></i>
                        <span>اطلاعات وارد‌شده برای ارسال سفارش استفاده می‌شود.</span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bi bi-check2-circle text-success mt-1 flex-shrink-0"></i>
                        <span>کد پستی باید دقیقاً ۱۰ رقم باشد.</span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bi bi-check2-circle text-success mt-1 flex-shrink-0"></i>
                        <span>شماره موبایل باید با ۰۹ شروع شود.</span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bi bi-check2-circle text-success mt-1 flex-shrink-0"></i>
                        <span>آدرس کامل شامل خیابان، کوچه و پلاک را وارد کنید.</span>
                    </li>
                </ul>
            </div>
        </div>

    </div>
</div>

@section UserFooterSection {
    <partial name="_ValidationScriptsPartial" />
}
