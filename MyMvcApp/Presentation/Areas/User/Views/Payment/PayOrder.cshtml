@model Data.DTOs.Order.OpenOrderDto
@{
    ViewData["Title"] = "درگاه پرداخت";
    Layout = null;
    var total = Model.TotalCartPrice();
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
            background: linear-gradient(135deg, #1a237e 0%, #283593 50%, #1565c0 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .gateway-card {
            background: #fff;
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        .gateway-header {
            background: linear-gradient(135deg, #1a237e, #1565c0);
            padding: 1.5rem 2rem;
            color: #fff;
        }
        .gateway-body { padding: 2rem; }
        .bank-logo {
            width: 48px; height: 48px;
            background: rgba(255,255,255,0.2);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .amount-box {
            background: #f0f4ff;
            border: 2px dashed #c5cae9;
            border-radius: 12px;
            padding: 1.25rem;
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .amount-value {
            font-size: 2rem;
            font-weight: 700;
            color: #1a237e;
            letter-spacing: -1px;
        }
        .merchant-info {
            background: #fafafa;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            font-size: 13px;
        }
        .sim-badge {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 8px;
            padding: .5rem 1rem;
            font-size: 12px;
            color: #856404;
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .btn-success-pay {
            background: linear-gradient(135deg, #2e7d32, #43a047);
            border: none; color: #fff;
            border-radius: 12px; padding: .75rem;
            font-size: 14px; font-weight: 600;
            transition: opacity .2s;
        }
        .btn-success-pay:hover { opacity: .9; color: #fff; }
        .btn-fail-pay {
            background: #fff;
            border: 2px solid #dc3545; color: #dc3545;
            border-radius: 12px; padding: .75rem;
            font-size: 14px; font-weight: 600;
            transition: all .2s;
        }
        .btn-fail-pay:hover { background: #dc3545; color: #fff; }
        .security-row {
            display: flex; align-items: center; justify-content: center;
            gap: .5rem; font-size: 11px; color: #78909c; margin-top: 1.5rem;
        }
        .font-12 { font-size: 12px; }
        .font-13 { font-size: 13px; }
    </style>
</head>
<body>

    <div class="gateway-card">

        @* ─── هدر درگاه ─── *@
        <div class="gateway-header">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bank-logo">
                    <i class="bi bi-bank2"></i>
                </div>
                <div>
                    <div class="fw-bold" style="font-size:15px">درگاه پرداخت اینترنتی</div>
                    <div style="font-size:11px;opacity:.8">Bank Payment Gateway Simulator</div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap" style="font-size:11px;opacity:.75">
                <span><i class="bi bi-shield-lock me-1"></i>اتصال امن SSL</span>
                <span><i class="bi bi-clock me-1"></i>زمان باقیمانده: <span id="timer">10:00</span></span>
            </div>
        </div>

        <div class="gateway-body">

            @* نشان شبیه‌سازی *@
            <div class="sim-badge">
                <i class="bi bi-exclamation-triangle me-1"></i>
                این یک درگاه شبیه‌سازی‌شده برای محیط توسعه است
            </div>

            @* مبلغ *@
            <div class="amount-box">
                <div class="text-muted font-12 mb-1">مبلغ قابل پرداخت</div>
                <div class="amount-value">@total.ToString("N0")</div>
                <div class="font-12 text-muted mt-1">تومان (معادل @((total * 10).ToString("N0")) ریال)</div>
            </div>

            @* اطلاعات پذیرنده *@
            <div class="merchant-info">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">پذیرنده:</span>
                    <span class="fw-bold">فروشگاه آنلاین</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">شماره سفارش:</span>
                    <span class="fw-bold text-primary">#@Model.Order.Id</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">تعداد اقلام:</span>
                    <span class="fw-bold">@Model.OrderDetails.Sum(x => x.Count) عدد</span>
                </div>
            </div>

            @* ─── فرم‌های شبیه‌سازی ─── *@
            @* hidden fieldهایی که model binding برای OpenOrderDto نیاز داره *@
            @{
                // فیلدهای مشترک هر دو فرم رو به صورت partial تعریف می‌کنیم
            }

            @* فرم پرداخت موفق *@
            <form asp-area="User" asp-controller="Payment" asp-action="PayOrder" method="post" class="mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Order.Id"    value="@Model.Order.Id">
                <input type="hidden" name="isSuccess"   value="true">
                @for (int i = 0; i < Model.OrderDetails.Count; i++)
                {
                    <input type="hidden" name="OrderDetails[@i].Count"
                           value="@Model.OrderDetails[i].Count">
                    <input type="hidden" name="OrderDetails[@i].ProductVariant.Product.Price"
                           value="@Model.OrderDetails[i].ProductVariant.Product.Price">
                }
                <button type="submit" class="btn btn-success-pay w-100">
                    <i class="bi bi-check-circle me-2"></i>شبیه‌سازی پرداخت موفق
                </button>
            </form>

            @* فرم پرداخت ناموفق *@
            <form asp-area="User" asp-controller="Payment" asp-action="PayOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Order.Id"  value="@Model.Order.Id">
                <input type="hidden" name="isSuccess" value="false">
                @for (int i = 0; i < Model.OrderDetails.Count; i++)
                {
                    <input type="hidden" name="OrderDetails[@i].Count"
                           value="@Model.OrderDetails[i].Count">
                    <input type="hidden" name="OrderDetails[@i].ProductVariant.Product.Price"
                           value="@Model.OrderDetails[i].ProductVariant.Product.Price">
                }
                <button type="submit" class="btn btn-fail-pay w-100">
                    <i class="bi bi-x-circle me-2"></i>شبیه‌سازی پرداخت ناموفق
                </button>
            </form>

            @* امنیت *@
            <div class="security-row">
                <i class="bi bi-lock-fill" style="color:#43a047"></i>
                <span>ارتباط شما با این درگاه کاملاً رمزگذاری شده است</span>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ─── تایمر ۱۰ دقیقه ───
        let seconds = 600;
        const timerEl = document.getElementById('timer');
        const interval = setInterval(() => {
            seconds--;
            if (seconds <= 0) { clearInterval(interval); timerEl.textContent = '00:00'; return; }
            const m = String(Math.floor(seconds / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            timerEl.textContent = `${m}:${s}`;
        }, 1000);
    </script>
</body>
</html>
