@using System.Security.Claims

@{
    var fullName   = User.FindFirst("FullName")?.Value
                  ?? User.FindFirst(ClaimTypes.Name)?.Value
                  ?? "کاربر";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action     = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action,     a, StringComparison.OrdinalIgnoreCase);

    @* int[] quickAmounts = new int[] { 50000, 100000, 200000, 500000, 1000000 }; *@
}

<style>
    body { margin-right: 240px !important; background: #f8fafc; }

    .user-sidebar {
        width: 240px;
        min-height: 100vh;
        background: #fff;
        border-left: 1px solid #e9ecef;
        position: fixed;
        right: 0;
        top: 0;
        z-index: 100;
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        overflow-y: auto;
    }
    .sidebar-nav-link {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .55rem .85rem;
        border-radius: 10px;
        font-size: 13px;
        color: #475569;
        text-decoration: none;
        transition: background .15s, color .15s;
        margin-bottom: 2px;
    }
    .sidebar-nav-link:hover  { background: #f8fafc; color: #1e293b; }
    .sidebar-nav-link.active { background: #fee2e2; color: #dc3545; font-weight: 600; }
    .sidebar-nav-link i      { font-size: 15px; width: 18px; }
    .sidebar-divider         { border-color: #f1f5f9; margin: .5rem 0; }
    .font-11                 { font-size: 11px; }
    .font-12                 { font-size: 12px; }

    .wallet-panel {
        position: fixed;
        top: 0;
        right: 240px;
        width: calc(100vw - 240px);
        height: 100vh;
        background: #fff;
        border-left: 1px solid #e2e8f0;
        box-shadow: -4px 0 20px rgba(0,0,0,0.08);
        z-index: 99;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    .wallet-panel.show { display: flex; }
    .wallet-panel-inner {
        width: 100%;
        max-width: 420px;
    }
</style>

<aside class="user-sidebar shadow-sm">

    @* برند *@
    <a href="/" class="d-flex align-items-center gap-2 text-decoration-none mb-4">
        <i class="bi bi-bag-heart-fill text-danger fs-4"></i>
        <span class="fw-bold text-dark font-14">فروشگاه</span>
    </a>

    @* پروفایل + موجودی *@
    <div class="d-flex align-items-center gap-2 bg-light rounded-3 p-2 mb-4">
        <div class="rounded-circle bg-danger text-white d-flex align-items-center
                    justify-content-center flex-shrink-0"
             style="width:36px;height:36px;font-size:15px">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="min-w-0">
            <div class="fw-bold font-12 text-dark text-truncate">@fullName</div>
            @await Component.InvokeAsync("GetLastUserData")
            <div class="font-11 text-muted">پنل کاربری</div>
        </div>
    </div>

    @* منوی اصلی *@
    <nav class="flex-grow-1">
        <p class="font-11 text-muted fw-bold mb-2 px-2">منو</p>

        <a asp-area="User" asp-controller="Account" asp-action="Dashboard"
           class="sidebar-nav-link @(IsActive("Account","Dashboard") ? "active" : "")">
            <i class="bi bi-grid-1x2"></i> داشبورد
        </a>

        <a asp-area="User" asp-controller="Order" asp-action="Cart"
           class="sidebar-nav-link @(IsActive("Order","Cart") ? "active" : "")">
            <i class="bi bi-cart3"></i> سبد خرید
        </a>

        <a asp-area="User" asp-controller="Order" asp-action="PaidOrders"
           class="sidebar-nav-link @(IsActive("Order","MyOrders") ? "active" : "")">
            <i class="bi bi-box-seam"></i> سفارش‌های من
        </a>

        <hr class="sidebar-divider">
        <p class="font-11 text-muted fw-bold mb-2 px-2">حساب کاربری</p>

        <a asp-area="User" asp-controller="Account" asp-action="EditUserDetail"
           class="sidebar-nav-link @(IsActive("Account","EditUserDetail") ? "active" : "")">
            <i class="bi bi-person-lines-fill"></i> اطلاعات کاربری
        </a>

        <a asp-area="User" asp-controller="Account" asp-action="ChangePassword"
           class="sidebar-nav-link @(IsActive("Account","ChangePassword") ? "active" : "")">
            <i class="bi bi-key"></i> تغییر رمز عبور
        </a>

        <hr class="sidebar-divider">

        @* کیف پول *@
        <button type="button" id="walletBtn"
                class="sidebar-nav-link text-success border-0 bg-transparent w-100">
            <i class="bi bi-wallet2"></i> کیف پول
        </button>

    </nav>

    @* پایین سایدبار *@
    <hr class="sidebar-divider mt-auto">
    <a asp-area="" asp-controller="Account" asp-action="Logout"
       class="sidebar-nav-link text-danger">
        <i class="bi bi-box-arrow-left"></i> خروج از حساب
    </a>
    <a href="/" class="sidebar-nav-link mt-1">
        <i class="bi bi-house"></i> بازگشت به سایت
    </a>

</aside>

@* پنل کیف پول *@
<div class="wallet-panel" id="walletPanel">
    <div class="wallet-panel-inner">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-success mb-0">
                    <i class="bi bi-wallet2 me-2"></i>شارژ کیف پول
                </h4>
                <p class="text-muted mb-0" style="font-size:13px;">مبلغ دلخواه خود را وارد کنید</p>
            </div>
            <button type="button" id="walletClose" class="btn btn-light border"
                    style="border-radius:10px;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @* <p class="text-muted mb-2" style="font-size:13px;">انتخاب سریع:</p>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (int a in quickAmounts)
            {
                <button type="button" class="btn btn-outline-success quick-amt"
                        data-val="@a" style="border-radius:10px; font-size:13px;">
                    @a.ToString("N0") تومان
                </button>
            }
        </div> *@

        <form asp-area="User" asp-controller="Payment" asp-action="AddBalance" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id"
                   value="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value">

            <div class="mb-4">
                <label class="form-label fw-bold">مبلغ (تومان)</label>
                <input type="number"
                       name="Amount"
                       id="walletAmount"
                       class="form-control form-control-lg text-center"
                       placeholder="مثال: 150000"
                       min="10000"
                       style="border-radius:12px; font-size:20px; font-weight:700;"
                       required>
                <div class="form-text">حداقل مبلغ: ۱۰,۰۰۰ تومان</div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold"
                    style="border-radius:12px;">
                <i class="bi bi-credit-card me-2"></i>ادامه و پرداخت
            </button>
        </form>

    </div>
</div>

<script>
    const walletBtn   = document.getElementById('walletBtn');
    const walletPanel = document.getElementById('walletPanel');
    const walletClose = document.getElementById('walletClose');

    walletBtn.addEventListener('click', () => walletPanel.classList.toggle('show'));
    walletClose.addEventListener('click', () => walletPanel.classList.remove('show'));

    document.querySelectorAll('.quick-amt').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('walletAmount').value = btn.dataset.val;
            document.querySelectorAll('.quick-amt').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        });
    });
</script>
